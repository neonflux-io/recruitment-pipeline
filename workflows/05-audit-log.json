      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ─── Batch 6 | Update Audit Context ─────────────────────────────────────────────\n// Sets audit log context in $execution.customData.\n// Error handler reads 'audit_logged' to know whether the audit row was written\n// before any downstream failure in Batch 6 itself.\n// Returns original pipeline payload with auditLoggedAt timestamp appended.\n// ─────────────────────────────────────────────────────────────────────────────\n\nconst item = $('When Called by Workflow').first().json;\n\n$execution.customData.set('audit_logged', 'true');\n\nreturn [{\n  json: {\n    ...item,\n    auditLoggedAt: new Date().toISOString()\n  }\n}];"
      }
    }
